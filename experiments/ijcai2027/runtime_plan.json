    "mcp": "2.3.0",
    "pydantic": "2.13.4"
  },
  "response_identity_policy": {
    "record_response_model": true,
    "record_system_fingerprint_when_available": true,
    "drift_action": "flag before aggregation; do not pool mismatched response identities silently"
  },
  "api_key_policy": {
    "environment_variable": "OPENROUTER_API_KEY",
    "store_in_repository": false,
    "print_in_logs": false
  },
  "supervisor_confirmation_required": true
